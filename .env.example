# ============================================================================
# AlRescate backend — variables de entorno (referencia completa)
# Copiá lo que necesites a un .env (gitignoreado) o al panel de env vars del host.
# El server valida esto al boot (src/common/env.validation.ts) y falla con mensaje
# claro si falta algo. Detalle de deploy: DEPLOYMENT.md.
# ============================================================================

# --- Obligatorias siempre ---
# Bucket de Storage (fotos de verificación, avatares, audio).
FIREBASE_STORAGE_BUCKET=alrescate-dev.firebasestorage.app

# --- Credenciales (obligatorias SALVO que uses emuladores) ---
# JSON inline de la service account O un path a un archivo .json montado.
# NUNCA commitear la key. En dev local: secrets/serviceAccountKey.dev.json (gitignoreado).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT=/ruta/al/serviceAccountKey.json

# --- Obligatoria en producción ---
# CSV de orígenes web permitidos para CORS (REST + Socket.IO). Sin ella, CORS queda
# abierto (solo aceptable en dev). El panel servido en /panel es same-origin y la app
# Android no manda Origin: no hace falta listarlos.
# ALLOWED_ORIGINS=https://alrescate.example,https://panel.alrescate.example

# --- Opcionales ---
# Puerto (default 8080).
# PORT=8080
# Forzar projectId (útil con emuladores cuando la app cliente usa otro proyecto).
# FIREBASE_PROJECT_ID=alrescate-cbb6a

# --- Emuladores (SOLO dev/tests; PROHIBIDAS en producción) ---
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Rate limiting (opcionales, defaults razonables) ---
# REST por IP (default 600 req / 60s):
# REST_RATE_LIMIT=600
# REST_RATE_WINDOW_MS=60000
# Sockets por-socket/por-evento (defaults en src/common/socket-throttle.ts):
# SOCKET_RATE_WINDOW_MS=10000
# SOCKET_RATE_LIMIT_EMERGENCY_ALERT=30
# SOCKET_RATE_LIMIT_SEND_MESSAGE=100
# SOCKET_RATE_LIMIT_AUDIO_MESSAGE=50
# SOCKET_RATE_LIMIT_UPDATE_LOCATION=300
# SOCKET_RATE_LIMIT_UPDATE_EMERGENCY_LOCATION=300
# SOCKET_RATE_LIMIT_UPDATE_HELPER_LOCATION=300
