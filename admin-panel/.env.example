# Config de la app WEB de Firebase.
# Registrala en la consola: Configuración del proyecto -> Tus apps -> Web (</>).
# Copiá este archivo a .env y completá los valores.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=alrescate-dev
VITE_FIREBASE_APP_ID=

# URL del backend NestJS
VITE_API_URL=http://127.0.0.1:8080

# Desarrollo contra los emuladores (Auth en 9099). 'true' o 'false'.
VITE_USE_EMULATOR=true
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
