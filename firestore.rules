rules_version = '2';

// Reglas de seguridad de Firestore — VERSIONADAS en git (parte del plan).
// Punto de partida (Fase 0): acceso de CLIENTES denegado por completo.
// Todo el acceso legítimo pasa por el backend (Admin SDK), que ignora estas reglas.
// Se afinan en Fase 1 (cerrar el agujero del cliente directo) y Fase 3 (modelo de estados/roles).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
