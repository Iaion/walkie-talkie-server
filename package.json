{
  "name": "alrescate-server",
  "version": "1.0.0",
  "description": "Servidor AlRescate — en migración de monolito (server.js) a NestJS (src/)",
  "main": "server.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "test": "jest --runInBand --forceExit",
    "test:ci": "nest build && firebase emulators:exec --project alrescate-dev \"jest --runInBand --forceExit\"",
    "lint": "eslint .",
    "format": "prettier --write \\src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^13.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.0.0",
    "prettier": "^3.8.4",
    "socket.io-client": "^4.7.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0"
  },
  "keywords": [
    "nestjs",
    "socket.io",
    "firebase",
    "alrescate"
  ],
  "author": "AlRescate",
  "license": "MIT"
}
